# Optional K2 / OpenAI-compatible endpoint.
# Leave K2_API_KEY blank to use the built-in local heuristic generator.
K2_API_KEY=
K2_BASE_URL=
K2_MODEL=K2-Horizon-375B-A23B

# If your sponsor gives you a full chat-completions URL, put it here.
# Example: https://provider.example/v1/chat/completions
K2_CHAT_URL=

# Frontend talks to FastAPI here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
